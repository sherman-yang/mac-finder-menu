<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- pkd refuses to register a com.apple.FinderSync extension that is not
	     sandboxed; verified on macOS 26.6. Everything below exists to give the
	     sandboxed extension (and the zsh child it spawns) enough reach to do the
	     work the user asked for. -->
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.files.user-selected.read-write</key><true/>
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
	</array>
	<!-- the bundled scripts report their result through osascript -->
	<key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
