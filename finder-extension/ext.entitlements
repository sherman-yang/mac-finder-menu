<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- pkd refuses to register a com.apple.FinderSync extension that is not
	     sandboxed; verified on macOS 26.6. The extension only builds the menu and
	     brokers every action to the unsandboxed host app (see host.swift). The
	     one write it needs: spool files carrying the request, because
	     LaunchServices does not deliver OpenConfiguration.arguments from a
	     sandboxed caller. -->
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/AFSCFinderMenu/</string>
	</array>
</dict>
</plist>
